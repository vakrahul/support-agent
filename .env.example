# Copy this file to `.env` and fill in values. Never commit `.env`.
# The eval harness runs fully in replay mode WITHOUT any key
# (cached responses under cache/). Keys are only needed for make eval-live.

# Gemini API key (paid or free tier). Used for intent classification,
# reply drafting (generator model) and reply judging (judge model).
GEMINI_API_KEY=

# Optional: Qdrant Cloud endpoint + key for the demo path.
# The evaluation always uses embedded local Qdrant (no account needed).
# QDRANT_URL=https://xxxx.gcp.cloud.qdrant.io
# QDRANT_API_KEY=

# Optional: Hugging Face token (avoids Hub rate limits when downloading
# the sentence-transformers weights on first run).
# HF_TOKEN=

# Model pins (defaults in src/config.py; override here if IDs churn).
# GENERATOR_MODEL=gemini-3.1-flash-lite
# JUDGE_MODEL=gemini-3.5-flash
